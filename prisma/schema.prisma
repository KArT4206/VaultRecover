generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum FileFormat {
  PDF
  ZIP
  RAR
  SEVEN_Z
  WORD
  EXCEL
  POWERPOINT
  UNKNOWN
}

enum JobStatus {
  PENDING
  ANALYZING
  QUEUED
  RUNNING
  RECOVERED
  FAILED
  CANCELLED
  UNSUPPORTED
}

enum RecoveryMode {
  FAST_CHECK
  DEEP_RECOVERY
  LEGACY
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  files         File[]
  jobs          RecoveryJob[]
  auditLogs     AuditLog[]
  securityEvents SecurityEvent[]
}

model File {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  objectKey     String    @unique
  originalName  String
  sizeBytes     Int
  sha256        String
  mimeType      String
  detectedFormat FileFormat @default(UNKNOWN)

  createdAt     DateTime  @default(now())
  expiresAt     DateTime?
  deletedAt     DateTime?

  analysis      FileAnalysis?
  jobs          RecoveryJob[]

  @@index([userId])
  @@index([sha256])
}

model FileAnalysis {
  id              String    @id @default(uuid())
  fileId          String    @unique
  file            File      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  format          FileFormat
  isEncrypted     Boolean
  encryptionType  String?
  entryCount      Int?
  uncompressedSize BigInt?
  recoverySupported Boolean @default(false)
  details         Json?

  createdAt       DateTime @default(now())
}

model RecoveryJob {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId        String
  file          File         @relation(fields: [fileId], references: [id], onDelete: Cascade)

  mode          RecoveryMode @default(FAST_CHECK)
  status        JobStatus    @default(PENDING)
  hints         Json?
  workerId      String?      // id of the Worker row that actually processed this job

  progress      Int          @default(0)
  candidatesTried Int        @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  runtimeMs     Int?
  errorMessage  String?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  strategyLogs  RecoveryStrategyLog[]
  result        RecoveryResult?
  downloads     Download[]

  @@index([userId])
  @@index([status])
}

model RecoveryStrategyLog {
  id          String      @id @default(uuid())
  jobId       String
  job         RecoveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  strategy    String
  candidatesTried Int     @default(0)
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  outcome     String?

  @@index([jobId])
}

model RecoveryResult {
  id          String      @id @default(uuid())
  jobId       String      @unique
  job         RecoveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  password    String
  strategy    String
  verifiedAt  DateTime    @default(now())
  resultObjectKey String?
}

model Download {
  id          String      @id @default(uuid())
  jobId       String
  job         RecoveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  token       String      @unique
  expiresAt   DateTime
  downloadedAt DateTime?
  createdAt   DateTime    @default(now())
}

model Worker {
  id            String   @id @default(uuid())
  hostname      String
  kind          String   @default("CPU") // "CPU" | "GPU" — which entrypoint this process is
  hasGpu        Boolean  @default(false) // result of a REAL capability probe at startup, never assumed
  gpuInfo       String?  // human-readable probe result (device name, or why none was found)
  status        String   @default("idle")
  lastHeartbeat DateTime @default(now())
  activeJobId   String?
}

model SystemSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
}

model SecurityEvent {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type        String
  detail      Json?
  ip          String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
}
