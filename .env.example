# --- Database ---
DATABASE_URL="postgresql://vaultrecover:vaultrecover@localhost:5432/vaultrecover"

# --- Redis (BullMQ queue + SSE pub/sub + rate limiting) ---
REDIS_URL="redis://localhost:6379"

# --- Auth.js ---
AUTH_SECRET="replace-with-a-random-32-byte-value"
NEXTAUTH_URL="http://localhost:3000"
# Optional — Google OAuth stays disabled until both are set:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Storage ---
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./storage"
# S3/MinIO vars (used once STORAGE_DRIVER=s3 provider is implemented):
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="vaultrecover"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_REGION="us-east-1"

# --- Security ---
DOWNLOAD_URL_SECRET="replace-with-a-random-32-byte-value"

# --- Usage limits (no payment system — fair-use limits instead) ---
MAX_FILE_SIZE="104857600"        # 100MB, bytes
MAX_ACTIVE_JOBS_PER_USER="3"
MAX_DAILY_JOBS="20"
MAX_JOB_RUNTIME="300000"         # 5 minutes, ms
FILE_RETENTION_MS="86400000"     # 24h, ms

# --- Tooling ---
QPDF_BIN="qpdf"
UNZIP_BIN="unzip"
WORKER_CONCURRENCY="2"
LOG_LEVEL="info"
NODE_ENV="development"

# --- Deployment target ---
# Set to "vercel" on the hosted serverless deployment: enables the in-process
# ZIP (ZipCrypto) recovery path and hides local-only formats in the UI.
NEXT_PUBLIC_DEPLOY_TARGET=""
VAULT_PURE_ZIP=""
